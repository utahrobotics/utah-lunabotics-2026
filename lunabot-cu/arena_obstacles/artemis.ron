
(
    // Arena boundary walls - positioned outside arena accounting for robot_radius expansion (0.4m default)
    // After expansion, inner edges will be exactly at arena boundary (0, 0, 6.88, 5.0)
    walls: [
        (-0.5, -0.5, 7.38, -0.4),      // South wall (expands to y=0 inner edge)
        (-0.5, 5.4, 7.38, 5.5),         // North wall (expands to y=5.0 inner edge)
        (-0.5, -0.5, -0.4, 5.5),        // West wall (expands to x=0 inner edge)
        (7.28, -0.5, 7.38, 5.5),        // East wall (expands to x=6.88 inner edge)
    ],

    // Central support pillar 
    // Defined as (center_x, center_y, dimensions) in meters
    pillars_rect: [
        (3.44, 2.5, 0.5, 0.5), 
    ],
    
    pillars: [],

    // Boulder obstacles - randomly positioned 
    // Defined as (center_x, center_y, radius) in meters
    // Specs: Minimum 3 boulders, 30-40 cm diameter (radius ~0.15-0.20m)
    boulders: [
        (2.3, 1.3, 0.18),  
        (4.0, 4.5, 0.20),  
        (6.5, 2.0, 0.15),  
    ],

    // Crater obstacles - varying depths and widths
    // Minimum 3 craters, up to 40-50 cm width 
    // Represented as circular obstacle zones
    craters: [
        (2.5, 3.0, 0.22),  
        (5.5, 1.5, 0.25),  
        (6.2, 3.8, 0.20),  
    ],
