(
    runtime: (
        rate_target_hz: 1000
    ),
    tasks:[
        // Uses a behavior tree to make decisions for the robot. 
        (
            id: "new_ai",
            type: "crate::tasks::ai::lunabot_ai::LunabotAi",
            config: {
                "obstacle_gradient_threshold_expander": 0.9,
                "obstacle_gradient_threshold_pathfinder": 0.3,
                "robot_radius_meters": 0.8,
                "arena": "artemis"
            },
            logging:(
                enabled: false
            )
        ),
        // waits for v4l udev add events, and reports them to the camera tasks
        // camera tasks can open the device if the port from the reported event
        // matches the port from the camera task config
        (
            id:"udev_monitor",
            type:"crate::tasks::UdevMonitor",
            config:{},
            // task is stubbed out in sim mode
            run_in_sim: false
        ),
        // subscribes to  point clouds from iceoryx2, published from c++ by the unilidar_iceoryx_publisher
        (
            id:"l2_pointcloud",
            type:"crate::tasks::sources::PointCloudIceoryxReceiver",
            config:{},
            logging: (
                enabled: true
            ),
            // task is stubbed in sim mode
            run_in_sim: false,
        ),
        // subscribes to imu information from the unilidar_iceoryx_publisher
        (
            id:"l2_imu",
            type:"crate::tasks::sources::ImuIceoryxReceiver",
            config:{},
            // task gets stubbed out in sim mode
            run_in_sim: false,
        ),
        // subscribes to depth frames and imu data from the external_tasks/realsense process
        (
            id:"realsense_subscriber",
            type: "crate::tasks::sources::RealsenseSubscriber",
            config: {
                // "serial_num": "044422250424",
                // dust protected cam
                // "serial_num": "341222301328",
                "serial_num": "311322302990",
                "camera_node": "upper_depth_camera"
            },
            logging: (
                enabled: true,
            ),
            run_in_sim: false
        ),
        // subscribes to 6dof messages from the intel T265 camera
        // subsrcibes to fisheye images as well
        (
            id: "t265_subscriber",
            type: "crate::tasks::sources::T265Subscriber",
            config: {
                "t265_velocity_variance": 1.0,
                "t265_angular_velocity_variance": 1.0,
                "pose_variance": 0.0005,
                "left_serial": "142122111023",
                "right_serial": "142122110508",
                "rear_serial": "929122111514",
            },
            logging: (
                enabled: true,
                // disable logging for images (it takes too long)
                disabled_slots: [1,2,3]
            ),
            run_in_sim: false
        ),
        // takes depth frames and imu information from the realsense subscriber and uses a compute shader pipeline to estimate a local and global map of obstacles
        (
            id:"occupancy_grid_pipeline",
            type: "crate::tasks::OccupancyGridTask",
            config: {
                "camera_node": "upper_depth_camera",
                "focal_length": 383,
                "ppx": 317.44882,
                "ppy": 245.91605,
                "heightmap_max_x": 10.0,
                "heightmap_max_y": 10.0,
                "heightmap_min_x": -3.0,
                "heightmap_min_y": -5.0,
                "heightmap_cell_size": 0.025,
                "bilateral_filter_kernel_radius": 5,
                "bilateral_filter_sigma_spatial":0.5,
                "bilateral_filter_sigma_range": 0.1,
                "gradient_filter_kernel_radius": 2,
                "gaussian_blur_kernel_radius": 3,
                "gaussian_sigma_spatial": 0.2,
                "outlier_filter_kernel_radius": 7,
                // outlier removal works best when the clear affected cells is enabled
                // this is because it allows the outlier cells to be re mapped on the next frame
                "outlier_filter_std_dev_threshold": 3.5,
                "outlier_filter_max_unknown_neighbors_ratio": 0.2,
                "use_bilateral_filter": false,
                "min_depth": 0.2,
                "max_depth": 2.0,
                "clear_affected_cells": false,
                "min_distance_to_clear": 1.5,

                // enable permanent obstacles: artemis, ucfright, or ucfleft
                "arena_obstacles": "artemis",

                // parameters for when to reset the local map
                "max_distance_traveled_before_reset": 1.5,
                "max_rotation_radians_before_reset": 0.1,

                // speed limit, refuses to map if the bot is moving too fast
                "max_angular_velocity": 1.0,
                "max_linear_velocity": 1.0,
                "max_acceleration": 2.5,
            },
            background: false,
            logging: (
                enabled: false,
            )
        ),
        // (deprecated)
        // registers point clouds into a global map, and estimates the isometry of the lidar node.
        // the isometry is relative to the robots starting position, not actual global coordinates
        (
            id:"l2_kiss_icp",
            type:"crate::tasks::KissIcp",
            config:{
                "voxel_size": .7,
                "max_range": 10.0,
                "min_range": 1.5,
                "max_points_per_voxel": 100,
                "initial_threshold": 1.0,
                "min_motion_th": 0.2,
                "enable_deskewing": true,
                "max_num_threads": 10,
                "convergence_criterion": 0.0001,
                "max_num_iterations": 500,
                "max_accumulation": 1,
                "max_point_age_seconds": 40.0,
                "min_reflectivity": 0.0,

                // max distances between poses used to deskew. if any pose is too far apart, we skip deskewing
                "max_angle_between_poses": 0.10472, // 6 degrees in radians
                "max_distance_between_poses": 0.05,
                // time between poses collected for deskewing
                "time_between_pose_collections_ms": 2,

                // kalman filtering parameters
                "icp_position_variance": 0.8,
                "icp_orientation_variance": 0.1,
            },
            logging: (
                enabled: false
            ),
            background: true
        ),
        // fuses information from T265s, IMUs, Apriltags, and ICP algos providing one global robot position.
        // position is logged to rerun at 60 hz
        (
            id:"localizer", type:"crate::tasks::Localizer",
            config:{
                "process_noise_position": 0.5,
                "process_noise_velocity": 0.5,
                "process_noise_orientation": 5.01,
                "process_noise_angular_velocity": 5.01,
                "process_noise_acceleration": 0.5,

                "initial_covariance": 100.0,
            },
            logging: (
                enabled: false
            )
        ),

        // receives messages from the ai and tells the motors to move accordingly
        (
            id:"motor_ctrl", type:"crate::tasks::sinks::MotorController", config:{
                "speed_multiplier": 1500,
                "vesc_pairs": [
                    {
                        "id1": 75,
                        "id2": 110,
                        "mask1": "Right",
                        "mask2": "Right",
                        "command_both": true,
                    },
                    {
                        "id1": 63,
                        "id2": 74,
                        "mask1": "Left",
                        "mask2": "Left",
                        "command_both": true,
                    }
                ],
            },
            run_in_sim: false,
        ),
        // uses async tasks to communicate with the pico on the v3 pcb that electrical team designed.
        // controls actuators and sends imu data to the localizer
        (
            id:"v3_pico", type: "crate::tasks::V3PicoTask", config:{
                "teri_mode": true,
            }
        ),
        // handles apriltag detections from all the cameras, combining them and then sending them over to the localizer
        (
            id: "detection_handler",
            type: "crate::tasks::AprilDetectionHandler",
            config: {
                // all tags > max_distance away will be ignored
                "max_distance": 20.5
            }
        ),


        // Special apriltag detection tasks for the T265's that handle un distortion.
        (
            id: "detector_cam_t265_left",
            type: "cu_apriltag::AprilTags",
            config: {
                "family": "tag36h11",
                "tag_size": 0.145,
                "fx": 1,
                "fy": 1,
                "cx": 960.84,
                "cy": 600.819,
                "camera_id": "142122111023",
                "distortion_path": "camera_configs/t265_distortion.ron",
            },
            logging: (
                enabled: true
            ),
            background: true,
        ),
        (
            id: "detector_cam_t265_right",
            type: "cu_apriltag::AprilTags",
            config: {
                "family": "tag36h11",
                "tag_size": 0.145,
                "fx": 1,
                "fy": 1,
                "cx": 960.84,
                "cy": 600.819,
                "camera_id": "142122110508",
                "distortion_path": "camera_configs/t265_distortion.ron",
            },
            logging: (
                enabled: true
            ),
            background: true,
        ),
        (
            id: "detector_cam_t265_rear",
            type: "cu_apriltag::AprilTags",
            config: {
                "family": "tag36h11",
                "tag_size": 0.145,
                "fx": 1,
                "fy": 1,
                "cx": 960.84,
                "cy": 600.819,
                "camera_id": "929122111514",
                "distortion_path": "camera_configs/t265_distortion.ron",
            },
            logging: (
                enabled: true
            ),
            background: true,
        ),

        // hardware encodes and streams the obstacle map.
        (
            id: "obstacle_gstreamer",
            type: "crate::tasks::ObstacleStreamer",
            config: {
                "width": 520,
                "height": 600,
                "fps": 30,
                "host": "0.0.0.0",
                "port": 5000,
                "bitrate": 2000,
            }
        ),

        // streams fisheye lenses for t265
        (
            id: "t265_left_gstreamer",
            type: "crate::tasks::T265Streamer",
            config: {
                "width": 848,
                "height": 800,
                "fps": 30,
                "host": "0.0.0.0",
                "port": 5001,
                "bitrate": 2000,
            }
        ),
        (
            id: "t265_right_gstreamer",
            type: "crate::tasks::T265Streamer",
            config: {
                "width": 848,
                "height": 800,
                "fps": 30,
                "host": "0.0.0.0",
                "port": 5002,
                "bitrate": 2000,
            }
        )
    ],
    cnx:[
        (src:"l2_imu",                        dst:"localizer",               msg:"crate::tasks::sources::ImuMeasurement"),
        (src:"l2_pointcloud",                 dst:"l2_kiss_icp",             msg:"iceoryx_types::IceoryxPointCloud"),
        (src:"l2_kiss_icp",                   dst:"localizer",               msg:"crate::tasks::IcpMeasurement"),
        (src:"lunabase_bridge/from_lunabase_rx", dst:"new_ai",                  msg:"common::FromLunabase"),
        (src:"localizer",                    dst:"lunabase_bridge/to_lunabase", msg:"common::FromLunabot"),
        // copper doesn't support multiple outputs on a single task so for now we just put them in a tuple and ignore one side
        (src:"realsense_subscriber",          dst:"occupancy_grid_pipeline", msg:"crate::payloads::depth_frame::CuDepthFrame<Vec<u16>>"),
        (src:"occupancy_grid_pipeline",       dst:"new_ai",                  msg:"crate::pathfinding::OccupancyGrid"),
        (src:"new_ai",                        dst:"motor_ctrl",              msg:"common::Steering"),
        (src:"new_ai",                        dst:"v3_pico",                 msg:"embedded_common::ActuatorCommand"),
        (src:"v3_pico",                       dst:"localizer",               msg:"embedded_common::FromPico"),
        (src:"detection_handler",             dst:"localizer",               msg:"Vec<crate::tasks::AprilTagMeasurement>"),
        (src:"t265_subscriber",               dst:"localizer",               msg:"crate::tasks::sources::T265Msg", src_port: Some(0)),
        (src:"t265_subscriber",               dst:"detector_cam_t265_left",  msg:"cu_sensor_payloads::CuImage<Vec<u8>>", src_port: Some(1)),
        (src:"t265_subscriber",               dst:"detector_cam_t265_right", msg:"cu_sensor_payloads::CuImage<Vec<u8>>", src_port: Some(2)),
        (src:"t265_subscriber",               dst:"detector_cam_t265_rear",  msg:"cu_sensor_payloads::CuImage<Vec<u8>>", src_port: Some(3)),

        (src:"detector_cam_t265_left",        dst:"detection_handler",       msg:"cu_apriltag::AprilTagDetections"),
        (src:"detector_cam_t265_right",       dst:"detection_handler",       msg:"cu_apriltag::AprilTagDetections"),
        (src:"detector_cam_t265_rear",        dst:"detection_handler",       msg:"cu_apriltag::AprilTagDetections"),

        (src:"t265_subscriber", dst:"t265_left_gstreamer", msg:"cu_sensor_payloads::CuImage<Vec<u8>>", src_port: Some(1)),
        (src:"t265_subscriber", dst:"t265_right_gstreamer", msg:"cu_sensor_payloads::CuImage<Vec<u8>>", src_port: Some(2)),

        (src:"occupancy_grid_pipeline",       dst: "obstacle_gstreamer",     msg:"crate::pathfinding::OccupancyGrid"),
        (src:"new_ai",                        dst: "obstacle_gstreamer",     msg:"Vec<[f32; 2]>"),
    ],

    // comms to lunabase software
    bridges: [
        (
            id: "lunabase_bridge",
            type: "crate::bridges::lunabase_bridge::Lunabase",
            config: {
                "max_pong_delay_ms": 500,
                "keep_alive_interval_ms": 20,
            },
            run_in_sim: true,
            channels: [
                Rx ( id: "from_lunabase_rx" ),
                Tx ( id: "to_lunabase" ),
            ],
        ),
    ],
    
    includes:[
        // starts a gstreamer pipeline that waits for a message from udev_monitor and then starts the pipeline accordingly
        // sends frames through a dynamic threshold and then to the apriltag detector, then to the detection handler.
        // frames are streamed over tcp to the host and port specified in the config
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"back",
                "port":"pci-0000:00:14.0-usb-0:5.3:1.0",
                "fx":667.0,
                "fy":667.0,
                "cx":960.84,
                "cy":600.819,
                "width":1920,
                "height":1200,
                "tcp_host":"0.0.0.0",
                "tcp_port":4000,
                "desired_index": "0"
            },
        ),
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"side",
                "port":"pci-0000:00:14.0-usb-0:7:1.0",
                "fx":1056.50,
                "fy":1056.50,
                "cx":913.26,
                "cy":604.28,
                "width":640,
                "height":480,
                "tcp_host":"0.0.0.0",
                "tcp_port":4001,
                "desired_index": "0"
            },
        ),
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"laptop_front",
                "port":"pci-0000:00:14.0-usb-0:4:1.0",
                "fx":939.93,
                "fy":938.93,
                "cx":640.84,
                "cy":340.819,
                "width":1280,
                "height":720,
                "tcp_host":"0.0.0.0",
                "tcp_port":4002,
                "desired_index": "0"
            }
        ),
        // the lite version doesnt include apriltags
        (
            path:"camera_configs/camera_template_gstreamer_lite.ron",
            params:{
                "id":"d456_rgb",
                "port":"pci-0000:e6:00.4-usb-0:1:1.3",
                "width":640,
                "height":480,
                "tcp_host":"0.0.0.0",
                "tcp_port":4003,
                "desired_index": "0"
            }
        ),
    ],
    //monitor:(type:"cu_cursive_consolemon::CuCursiveConsoleMon"),
    // monitor:(type:"cu_consolemon::CuConsoleMon"),
    monitor: (type:"simple_monitor::SimpleMonitor"),
    logging:(
        // if true, each output payload of each will be logged unless a task opts out
        enable_task_logging: false,
        section_size_mib: 100,
        copperlist_count: 20,
    ),
)
