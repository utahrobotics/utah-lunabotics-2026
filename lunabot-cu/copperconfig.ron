(
    tasks:[
        // waits for v4l udev add events, and reports them to the camera tasks
        // camera tasks can open the device if the port from the reported event
        // matches the port from the camera task config
        (
            id:"udev_monitor",
            type:"crate::tasks::UdevMonitor",
            config:{}
        ),
        // subscribes to  point clouds from iceoryx2, published from c++ by the unilidar_iceoryx_publisher
        (
            id:"l2_pointcloud",
            type:"crate::tasks::sources::PointCloudIceoryxReceiver",
            config:{},
            logging: (
                enabled: false
            ),
        ),
        // subscribes to imu information from the unilidar_iceoryx_publisher
        (
            id:"l2_imu",
            type:"crate::tasks::sources::ImuIceoryxReceiver",
            config:{}
        ),
        // subscribes to pointclouds from the external_tasks/realsense process
        (
            id:"realsense_pointcloud",
            type:"crate::tasks::sources::RealSensePointCloudReceiver",
            config:{
                "service": "realsense/309622300683/cloud",
                "camera_node": "upper_depth_camera"
            },
            logging: (
                enabled: false
            ),
        ),
        // registers point clouds into a global map, and estimates the isometry of the lidar node.
        // the isometry is relative to the robots starting position, not actual global coordinates
        (
            id:"l2_kiss_icp",
            type:"crate::tasks::KissIcp",
            config:{
                "voxel_size": 0.5,
                "max_range": 100.0,
                "min_range": 0.2,
                "max_points_per_voxel": 40,
                "initial_threshold": 2.0,
                "min_motion_th": 0.1,
                "max_threshold": 5.0,
                "enable_deskewing": true,
                "map_log_interval_secs": 1.0,
            },
            logging: (
                enabled: false
            ),
            background: true
        ),
        // KISS ICP isn't really build for point clouds from RGB-D, so
        // eventually we will probably end up only using the realsense for obstacle detection
        (
            id:"realsense_kiss_icp",
            type:"crate::tasks::KissIcp", config:{
                "voxel_size": 0.15,
                "max_range": 100.0,
                "min_range": 0.,
                "max_points_per_voxel": 20,
                "initial_threshold": 2.0,
                "min_motion_th": 0.1,
                "min_threshold": 0.05,
                "max_threshold": 5.0,
                "enable_deskewing": false,
                "map_log_interval_secs": 1.0,
            },
            logging: (
                enabled: false
            ),
            background: true
        ),
        // fuses information from IMUs, Apriltags, and ICP algos providing one global robot position.
        // position is logged to rerun at 60 hz
        (
            id:"localizer", type:"crate::tasks::sinks::Localizer",
            config:{}
        ),
        // receives messages from the lunabase over UDP
        (
            id:"lunabase", type:"crate::tasks::sources::Lunabase", config:{
                "max_pong_delay_ms": 500,
            },
        ),
        // subscribes to messages published by external-tasks/lunabot-ai2
        (
            id:"ai_source", type:"crate::tasks::sources::AiSource", config:{}
        ),
        // messages sent to the ai_sink are sent over IPC to lunabot-ai2
        (
            id:"ai_sink", type:"crate::tasks::sinks::AiSink", config:{}
        ),
        // receives messages from the ai_source and sends them over serial to the pico which then moves the actuators
        (
            id:"actuator_ctrl", type:"crate::tasks::sinks::ActuatorController", config:{}
        ),
        // receives messages from the ai_source and tells the motors to move accordingly
        (
            id:"motor_ctrl", type:"crate::tasks::sinks::MotorController", config:{
                "speed_multiplier": 1500,
                "vesc_pairs": [
                    // yes having these as strings is janky but it works
                    "VescPair(
                        id1: 75,
                        id2: 110,
                        mask1: Right,
                        mask2: Right
                    )",
                    "VescPair(
                        id1: 63,
                        id2: 74,
                        mask1: Left,
                        mask2: Left
                    )"
                ]
            }
        ),
        // handles apriltag detections from all the cameras, combining them and then sending them over to the localizer
        (
            id: "detection_handler",
            type: "crate::tasks::AprilDetectionHandler",
            logging: (
                enabled: false
            ),
        )
    ],
    cnx:[
        (src:"l2_imu", dst:"localizer", msg:"iceoryx_types::ImuMsg"),
        (src:"l2_pointcloud", dst: "l2_kiss_icp", msg:"iceoryx_types::IceoryxPointCloud"),
        (src:"realsense_pointcloud", dst: "realsense_kiss_icp", msg:"iceoryx_types::IceoryxPointCloud"),
        (src:"l2_kiss_icp", dst:"localizer", msg:"cu_spatial_payloads::EncodableIsometry"),
        (src:"realsense_kiss_icp", dst:"localizer", msg:"cu_spatial_payloads::EncodableIsometry"),
        (src:"lunabase", dst:"ai_sink", msg:"Option<common::FromLunabase>"),
        // copper doesn't support multiple outputs on a single task so for now we just put them in a tuple and ignore one side
        (src:"ai_source", dst:"motor_ctrl", msg:"(Option<common::Steering>, Option<[u8; 5]>)"),
        (src:"ai_source", dst:"actuator_ctrl", msg:"(Option<common::Steering>, Option<[u8; 5]>)"),
        (
            src: "detection_handler",
            dst: "localizer",
            msg: "Box<std::collections::HashMap<String, cu_spatial_payloads::EncodableIsometry>>"
        ),
    ],
    includes:[
        // starts a gstreamer pipeline that waits for a message from udev_monitor and then starts the pipeline accordingly
        // sends frames through a dynamic threshold and then to the apriltag detector, then to the detection handler.
        // frames are streamed over udp to the host and port specified in the config
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"back",
                "port":"pci-0000:35:00.0-usb-0:1:1.0",
                "fx":689.93,
                "fy":689.93,
                "cx":320.84,
                "cy":240.819,
                "width":640,
                "height":480,
                "udp_host":"127.0.0.1",
                "udp_port":5004,
            },
        ),
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"side",
                "port":"pci-0000:00:14.0-usb-0:1:1.0",
                "fx":689.93,
                "fy":689.93,
                "cx":320.84,
                "cy":240.819,
                "width":640,
                "height":480,
                "udp_host":"127.0.0.1",
                "udp_port":5003,
            },
        ),
        (
            path:"camera_configs/camera_template_gstreamer.ron",
            params:{
                "id":"laptop_front",
                "port":"pci-0000:00:14.0-usb-0:4:1.0",
                "fx":939.93,
                "fy":938.93,
                "cx":640.84,
                "cy":340.819,
                "width":1280,
                "height":720,
                "udp_host":"127.0.0.1",
                "udp_port":5006,
            },
        ),
    ],
    //monitor:(type:"cu_cursive_consolemon::CuCursiveConsoleMon"),
    // monitor:(type:"cu_consolemon::CuConsoleMon"),
    logging:(
        enable_task_logging:false,
        section_size_mib:100,
    ),
)
