(
    tasks: [
        (
            id: "cam_{{id}}",
            type: "crate::tasks::CuDefaultAutoGStreamer",
            config: {
                "camera_id": "cam_{{id}}",
                "device_port": "{{port}}",
                "pipeline": "v4l2src device=<devpath> ! image/jpeg,width={{width}},height={{height}},framerate=30/1 ! jpegdec ! tee name=t ! queue leaky=upstream ! videoconvert ! video/x-raw,format=GRAY8 ! appsink name=copper_cam_{{id}} t. ! queue leaky=upstream ! videoconvert ! video/x-raw,format=NV12 ! vaapih264enc bitrate=2000 ! mpegtsmux ! tcpserversink host={{tcp_host}} port={{tcp_port}} sync=false",
                "caps": "video/x-raw, format=GRAY8, width={{width}}, height={{height}}",
                "timeout_ms": 500,
                "desired_index": "{{desired_index}}",
            },
            logging: (
                enabled: false
            ),
        ),
        (
            id: "gst_convert_{{id}}",
            type: "crate::tasks::GstToImage",
            config: {
                "width": {{width}},
                "height": {{height}},
                "pixel_format": "GRAY",
                "block_radius": 50,
            },
            logging: (
                enabled: false
            ),
            background: true
        ),
        (
            id: "detector_cam_{{id}}",
            type: "cu_apriltag::AprilTags",
            config: {
                "family": "tag36h11",
                "tag_size": 0.145,
                "fx": {{fx}},
                "fy": {{fy}},
                "cx": {{cx}},
                "cy": {{cy}},
                "camera_id": "cam_{{id}}",
            },
            logging: (
                enabled: true
            ),
            background: true,
        )
    ],
    cnx: [
        (src: "udev_monitor", dst: "cam_{{id}}", msg: "crate::tasks::NewDevice"),
        (src: "cam_{{id}}", dst: "gst_convert_{{id}}", msg: "crate::tasks::CuGstBuffer"),
        (src: "gst_convert_{{id}}", dst: "detector_cam_{{id}}", msg: "cu_sensor_payloads::CuImage<Vec<u8>>"),
        (src: "detector_cam_{{id}}", dst: "detection_handler", msg: "cu_apriltag::AprilTagDetections"),
    ],
)
