<mujoco model="artemis_arena">
  <!-- Compiler settings -->
  <default>
    <default class="visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0" />
    </default>
    <default class="collision">
      <geom group="3" type="mesh" />
    </default>
  </default>
  <!-- Visual settings -->
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" />
    <rgba fog="0.07 0.07 0.07 1" />
    <global offwidth="1920" offheight="1080" />
  </visual>


  <include file="meshes/lunar_surface/lunar_surface.xml" />
  <include file="meshes/arena_columns/arena_columns.xml" />
  <include file="meshes/arena_pipe/arena_pipe.xml" />
  <include file="meshes/arena_walls/arena_walls.xml" />
  <include file="meshes/arena_window_frames/arena_window_frames.xml" />
  <include file="meshes/arena_windows/arena_windows.xml" />
  <include file="meshes/rock_rough/rock_rough.xml" />


  <!-- Worldbody -->
  <worldbody>

    <!-- Lights -->
    <light name="sun" directional="true" pos="0 0 10" dir="-0.5 0.1 -0.9"
      diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" />

    <!-- Camera -->
    <camera name="user_camera" pos="0.550397 7.43232 16.7573"
      xyaxes="-0.997 -0.078 0 0.024 -0.309 0.951" />

  </worldbody>

  <!-- Actuators (if needed for control) -->
  <actuator>
    <!-- Add actuators here if you need to control any bodies -->
  </actuator>

  <!-- Sensors (if needed) -->
  <sensor>
    <!-- Add sensors here if needed -->
  </sensor>
</mujoco>