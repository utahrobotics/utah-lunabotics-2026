; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="new-lunabase"
run/main_scene="uid://cxqk5j2vp8obb"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://c3b2y3ky1m03k"

[autoload]

NotificationCanvasGlobal="*res://GUI/NotificationSystem/Assets/NotificationCanvas.tscn"
SettingsMenu="*res://GUI/SettingsMenu/Scene/SettingsMenu.tscn"

[display]

