; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="new-lunabase"
run/main_scene="uid://cxqk5j2vp8obb"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://c3b2y3ky1m03k"

[autoload]

NotificationCanvasGlobal="res://GUI/NotificationSystem/Assets/NotificationCanvas.tscn"
SettingsMenu="*res://GUI/SettingsMenu/Scene/SettingsMenu.tscn"
GlobalLunabaseConnection="*uid://ccrcffoncdpkm"

[display]

window/size/viewport_width=1200
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick_plus/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "gray",
"res://GUI/": "green",
"res://Systems/": "red"
}

